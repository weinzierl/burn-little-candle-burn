<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key><string>Linea</string>
  <key>settings</key>
  <array>
    <dict><key>settings</key><dict>
      <key>foreground</key><string>#EFE8D8</string>
      <key>background</key><string>#00000000</string>
    </dict></dict>
    <dict><key>scope</key><string>comment, punctuation.definition.comment</string>
      <key>settings</key><dict><key>foreground</key><string>#8A9A9C</string><key>fontStyle</key><string>italic</string></dict></dict>
    <dict><key>scope</key><string>keyword, storage, storage.type, storage.modifier, keyword.other, keyword.operator</string>
      <key>settings</key><dict><key>foreground</key><string>#E0AE4E</string></dict></dict>
    <dict><key>scope</key><string>entity.name.type, support.type, entity.name.struct, entity.name.impl, storage.type.core.rust, support.class</string>
      <key>settings</key><dict><key>foreground</key><string>#9CC3CB</string></dict></dict>
    <dict><key>scope</key><string>entity.name.function, support.function, meta.function-call</string>
      <key>settings</key><dict><key>foreground</key><string>#EFE8D8</string><key>fontStyle</key><string>bold</string></dict></dict>
    <dict><key>scope</key><string>string, string.quoted</string>
      <key>settings</key><dict><key>foreground</key><string>#B4C283</string></dict></dict>
    <dict><key>scope</key><string>constant.numeric, constant.language, constant.other</string>
      <key>settings</key><dict><key>foreground</key><string>#E39475</string></dict></dict>
    <dict><key>scope</key><string>meta.attribute, punctuation.definition.attribute, support.macro, entity.name.function.macro</string>
      <key>settings</key><dict><key>foreground</key><string>#D7A2A0</string></dict></dict>
  </array>
</dict>
</plist>
